generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum AuthProvider {
  GOOGLE
  GITHUB
  EMAIL
}

enum MediaDisposition {
  VIEW
  DOWNLOAD
}

enum OwnerType {
  USER
  GUEST
}

enum ClaimStatus {
  UNCLAIMED
  CLAIMED
  EXPIRED
}

enum AccountType {
  FREE_6M
  SUBSCRIPTION
}

enum V2UploadStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
  ABORTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  passwordResetRequiredAt DateTime?
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String? @unique
  emailVerificationTokenExpiresAt DateTime?
  passwordResetTokenHash String? @unique
  passwordResetTokenExpiresAt DateTime?
  accountDeletionCodeHash String?
  accountDeletionCodeExpiresAt DateTime?
  role         UserRole @default(USER)
  accountType  AccountType @default(FREE_6M)
  planName     String?
  planValidUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities   UserIdentity[]
  loginSessions LoginSession[]
  mediaFiles   MediaFile[]
  mediaBatches MediaBatch[]
  claimedMedia MediaFile[] @relation("claimedBy")
}

model LoginSession {
  id              String   @id @default(uuid())
  userId          String
  refreshTokenHash String   @unique
  ipAddress       String?
  userAgent       String?
  browser         String?
  os              String?
  deviceType      String?
  deviceModel     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastActivityAt  DateTime @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, revokedAt])
}

model UserIdentity {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerSubjectId String
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubjectId])
}

model GuestSession {
  id             String    @id @default(uuid())
  tokenHash      String    @unique
  startedAt      DateTime?
  expiresAt      DateTime?
  uploadCount    Int       @default(0)
  totalBytes     BigInt    @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  mediaFiles     MediaFile[]
  mediaBatches   MediaBatch[]
}

model MediaFile {
  id               String           @id @default(uuid())
  ownerType        OwnerType
  userId           String?
  guestSessionId   String?
  claimedByUserId  String?
  claimStatus      ClaimStatus      @default(UNCLAIMED)
  filename         String
  mimeType         String
  extension        String?
  sizeBytes        BigInt
  storagePath      String
  isActive         Boolean          @default(true)
  allowDownload    Boolean          @default(false)
  disposition      MediaDisposition @default(VIEW)
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user          User?         @relation(fields: [userId], references: [id])
  guestSession  GuestSession? @relation(fields: [guestSessionId], references: [id])
  claimedBy     User?         @relation("claimedBy", fields: [claimedByUserId], references: [id])
  versions      MediaVersion[]
  imageLinks    ImageLink[]
  qrTokens      QrToken[]
  batchItems    MediaBatchItem[]

  @@index([userId])
  @@index([guestSessionId])
  @@index([expiresAt])
}

model MediaBatch {
  id             String        @id @default(uuid())
  ownerType      OwnerType
  userId         String?
  guestSessionId String?
  name           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User?           @relation(fields: [userId], references: [id])
  guestSession GuestSession?   @relation(fields: [guestSessionId], references: [id])
  items        MediaBatchItem[]
  shareToken   BatchShareToken?

  @@index([userId])
  @@index([guestSessionId])
}

model MediaBatchItem {
  id         String    @id @default(uuid())
  batchId    String
  mediaFileId String
  createdAt  DateTime  @default(now())

  batch     MediaBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  mediaFile MediaFile  @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@unique([batchId, mediaFileId])
  @@index([mediaFileId])
}

model BatchShareToken {
  id            String    @id @default(uuid())
  batchId       String    @unique
  token         String    @unique
  allowDownload Boolean   @default(false)
  hideFilenames Boolean   @default(false)
  passwordHash  String?
  previewViewLimit Int?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  batch MediaBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MediaVersion {
  id          String   @id @default(uuid())
  mediaFileId String
  versionNo   Int
  storagePath String
  sizeBytes   BigInt
  mimeType    String
  createdAt   DateTime @default(now())

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@unique([mediaFileId, versionNo])
}

model ImageLink {
  id          String   @id @default(uuid())
  mediaFileId String
  extension   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model QrToken {
  id          String   @id @default(uuid())
  mediaFileId String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AccessLog {
  id          String   @id @default(uuid())
  mediaFileId String?
  action      String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model AdminAccessToken {
  id                String   @id @default(uuid())
  jtiHash           String   @unique
  userId            String
  superuserEmail    String
  challengeHash     String?  @unique
  challengeExpiresAt DateTime?
  challengeUsedAt   DateTime?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([challengeExpiresAt])
}

model AdminSession {
  id               String   @id @default(uuid())
  sessionTokenHash String   @unique
  userId           String
  superuserEmail   String
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  lastActivityAt   DateTime @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokeReason     String?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastActivityAt])
}

model AdminAuditLog {
  id             String   @id @default(uuid())
  superuserEmail String
  action         String
  status         String
  ipAddress      String?
  userAgent      String?
  targetUserId   String?
  details        Json?
  createdAt      DateTime @default(now())

  @@index([action])
  @@index([status])
  @@index([targetUserId])
  @@index([createdAt])
}

model V2Upload {
  id          String         @id @default(uuid())
  fileId      String         @unique @map("file_id")
  userId      String         @map("user_id")
  fileName    String         @map("file_name")
  fileSize    BigInt         @map("file_size")
  mimeType    String?        @map("mime_type")
  s3Key       String         @map("s3_key")
  s3Bucket    String         @map("s3_bucket")
  status      V2UploadStatus
  uploadId    String?        @map("upload_id")
  etags       Json?
  fileUrl     String?        @map("file_url")
  createdAt   DateTime       @default(now()) @map("created_at")
  completedAt DateTime?      @map("completed_at")
  metadata    Json?

  @@index([userId], map: "idx_v2_uploads_user_id")
  @@index([status], map: "idx_v2_uploads_status")
  @@index([fileId], map: "idx_v2_uploads_file_id")
  @@map("v2_uploads")
}
